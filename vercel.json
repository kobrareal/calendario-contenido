{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/wayfarer/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/:token",
      "destination": "/index.html"
    }
  ]
}
