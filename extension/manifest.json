{
  "manifest_version": 3,
  "name": "Ideas al Calendario de Contenido",
  "version": "1.0.0",
  "description": "Guardá cualquier imagen o texto de la web como idea en tu Calendario de Contenido, con un click derecho.",

  "icons": {
    "16": "iconos/icono-16.png",
    "32": "iconos/icono-32.png",
    "48": "iconos/icono-48.png",
    "128": "iconos/icono-128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Ideas al Calendario de Contenido"
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "scripting",
    "activeTab"
  ],

  "host_permissions": [
    "https://calendario-contenido-kappa.vercel.app/*"
  ]
}
